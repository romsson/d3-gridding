{
  "name": "d3-gridding",
  "version": "0.2.0",
  "description": "Grids for rapid d3 charts mock-ups",
  "keywords": [
    "d3",
    "d3-module",
    "grid",
    "visualization"
  ],
  "homepage": "https://github.com/romsson/d3-gridding",
  "license": "BSD-3-Clause",
  "author": {
    "name": "Romain Vuillemot",
    "url": "http://romain.vuillemot.net/"
  },
  "main": "dist/d3-gridding.js",
  "unpkg": "dist/d3-gridding.min.js",
  "jsdelivr": "dist/d3-gridding.min.js",
  "module": "src/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/romsson/d3-gridding.git"
  },
  "files": [
    "dist/**/*.js",
    "src/**/*.js"
  ],
  "scripts": {
    "build": "rm -rf dist && rollup -c",
    "pretest": "npm run build",
    "test": "tape -r esm 'test/**/*-test.js' && eslint src",
    "prepublish": "rm -rf dist && npm test",
    "postpublish": "zip -j dist/d3-gridding.zip -- LICENSE README.md dist/d3-gridding.js dist/d3-gridding.esm.js dist/d3-gridding.min.js"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "eslint": "^8.57.0",
    "esm": "^3.2.25",
    "package-preamble": "^0.1.0",
    "rollup": "^4.9.6",
    "tape": "^5.7.5",
    "uglify-js": "^3.17.4",
    "watch": "^1.0.2"
  },
  "dependencies": {
    "d3": "^7.8.5",
    "d3-array": "^3.2.4",
    "d3-hierarchy": "^3.1.2",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0"
  }
}